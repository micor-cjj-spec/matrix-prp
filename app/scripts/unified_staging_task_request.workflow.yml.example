# INERT EXAMPLE. Do not copy into .github/workflows or configure secrets without approval.
# Requires independently verified protected main and staging-only Environment branch policy.
name: PRP unified staging read smoke
on:
  issue_comment:
    types: [created]
permissions:
  contents: read
jobs:
  preflight:
    if: >-
      github.repository_id == '1261866723' &&
      github.event.issue.number == 396 &&
      github.event.comment.body == '/prp-uat-smoke' &&
      github.actor_id == '123868412' &&
      github.run_attempt == '1' &&
      github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 3
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Admit exact owner request
        run: node app/scripts/unified_staging_task_request.cjs
  smoke:
    needs: preflight
    if: needs.preflight.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 4
    # Only admitted requests reach concurrency; unrelated issue comments cannot replace a pending smoke.
    concurrency:
      group: prp-unified-staging-read-smoke
      cancel-in-progress: false
    environment: prp-staging-uat
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Require native fetch and timeout support
        run: node -e 'if(Number(process.versions.node.split(".")[0])<22)process.exit(2)'
      - name: Execute fixed staging-only read contract
        env:
          PRP_STAGE_UAT_USER: ${{ secrets.PRP_STAGE_UAT_USER }}
          PRP_STAGE_UAT_PASSWORD: ${{ secrets.PRP_STAGE_UAT_PASSWORD }}
          PRP_STAGE_UAT_OWNER_ID: ${{ secrets.PRP_STAGE_UAT_OWNER_ID }}
        run: node app/scripts/unified_staging_task_receipt.cjs
