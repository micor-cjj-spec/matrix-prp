{
  "uid": "prp-gateway-identity-candidate",
  "title": "PRP gateway and identity (offline candidate)",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape reachability and Nginx target",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"p2-nginx|p2-keycloak\"}"
        },
        {
          "refId": "B",
          "expr": "nginx_up{job=\"p2-nginx\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Nginx connections",
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active{job=\"p2-nginx\"}"
        },
        {
          "refId": "B",
          "expr": "nginx_connections_waiting{job=\"p2-nginx\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Nginx aggregate requests per second",
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total{job=\"p2-nginx\"}[2m])"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Keycloak JVM memory",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes{job=\"p2-keycloak\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Keycloak fixture discovery request rate",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"p2-keycloak\"}[2m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Keycloak fixture datasource pool",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "agroal_active_count{job=\"p2-keycloak\"}"
        },
        {
          "refId": "B",
          "expr": "agroal_available_count{job=\"p2-keycloak\"}"
        }
      ]
    }
  ]
}
