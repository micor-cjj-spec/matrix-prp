          ["/usr/bin/python3", "-E", "-s", "/opt/matrix-prp-remote-executor-v11/src/bridge.py", "receive-v11"],
          {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8", "SSH_ORIGINAL_COMMAND": "receive-v11"})
