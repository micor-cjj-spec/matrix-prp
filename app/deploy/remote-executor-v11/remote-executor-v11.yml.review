# REVIEW ONLY. Not a registered GitHub workflow.
# Do not copy to .github/workflows or configure environment/variables without approval.
name: Remote Executor V1.1 (staging only)
on:
  issue_comment:
    types: [created]
permissions:
  contents: read
concurrency:
  group: prp-remote-v11-506
  cancel-in-progress: false
jobs:
  relay:
    if: >-
      github.event_name == 'issue_comment' &&
      github.repository == 'micor-cjj-spec/matrix-prp' &&
      github.ref == 'refs/heads/main' &&
      vars.PRP_REX_V11_ENABLED == 'true' &&
      github.event.issue.number == 506 &&
      !github.event.issue.pull_request &&
      github.event.issue.state == 'open' &&
      github.event.sender.id == 123868412 &&
      github.event.sender.login == 'micor-cjj-spec' &&
      github.event.comment.user.id == 123868412 &&
      github.event.comment.author_association == 'OWNER' &&
      startsWith(github.event.comment.body, '/prp-remote-v11-approve ')
    runs-on: ubuntu-latest
    environment: remote-executor-v11-staging
    timeout-minutes: 6
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Relay approved encrypted request
        env:
          PRP_REX_V11_ENABLED: ${{ vars.PRP_REX_V11_ENABLED }}
          PRP_REX_V11_HOST: ${{ secrets.PRP_REX_V11_HOST }}
          PRP_REX_V11_SSH_KEY: ${{ secrets.PRP_REX_V11_SSH_KEY }}
          PRP_REX_V11_KNOWN_HOSTS: ${{ secrets.PRP_REX_V11_KNOWN_HOSTS }}
          GH_TOKEN: ${{ github.token }}
        run: python3 -E -s app/deploy/remote-executor-v11/actions_bridge.py
