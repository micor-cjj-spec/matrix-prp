# EXAMPLE ONLY: populate as root in /etc/matrix-prp/backup.env, chmod 0600.
# The endpoint must be on an independent host/provider, with TLS and a private bucket.
RESTIC_REPOSITORY=s3:https://s3.example.com/prp-private-backups/prod
RESTIC_PASSWORD_FILE=/etc/matrix-prp/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_RESTRICTED_BACKUP_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_RESTRICTED_BACKUP_SECRET
# Required HTTPS webhook (e.g. a private corporate notification endpoint).
PRP_BACKUP_ALERT_WEBHOOK_URL=https://alerts.example.com/replace-with-private-token
