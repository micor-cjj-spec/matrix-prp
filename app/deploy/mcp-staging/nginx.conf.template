# HTTP behind a *separate* reviewed public TLS server. No direct WAN listeners.
server {
    listen 8080;
    server_name ${PRP_STAGE_HOST};
    server_tokens off;
    if ($host != ${PRP_STAGE_HOST}) { return 421; }

    location = /prp { return 301 /prp/; }
    # Never let an incorrect /prp/api/ path silently fall back to the SPA.
    location ^~ /prp/api/ { return 404; }
    location = /prp/index.html {
        alias /usr/share/nginx/html/index.html;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /prp/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /prp/index.html;
    }

    location = /.well-known/oauth-protected-resource/api/mcp {
        limit_except GET { deny all; }
        proxy_pass http://backend:8080;
        proxy_set_header Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location = /api/mcp {
        limit_except POST { deny all; }
        client_max_body_size 128k;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        add_header Cache-Control "no-store" always;
    }

    location = /api/mcp/link {
        limit_except POST { deny all; }
        client_max_body_size 8k;
        proxy_pass http://backend:8080;
        proxy_set_header Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / { return 404; }
}
