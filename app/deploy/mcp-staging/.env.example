# Staging ONLY. Copy to .env (ignored by Git). Generate unique secrets outside source control.
# For real staging, replace both hosts with operator-controlled HTTPS DNS records.
PRP_STAGE_PUBLIC_HOST=prp-test.micor.top
PRP_STAGE_PUBLIC_URL=https://prp-test.micor.top
PRP_STAGE_MCP_RESOURCE=https://prp-test.micor.top/api/mcp
PRP_STAGE_AUTH_PUBLIC_URL=https://auth-test.micor.top
PRP_STAGE_AUTH_ISSUER=https://auth-test.micor.top/realms/prp-mcp
PRP_STAGE_AUTH_JWKS_URI=https://auth-test.micor.top/realms/prp-mcp/protocol/openid-connect/certs

# Never paste production credentials here.
PRP_STAGE_DB_ROOT_PASSWORD=REPLACE_WITH_32_RANDOM_BYTES_HEX
PRP_STAGE_DB_PASSWORD=REPLACE_WITH_ANOTHER_32_RANDOM_BYTES_HEX
PRP_STAGE_JWT_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_BYTES_HEX
PRP_STAGE_ADMIN_USERNAME=stage_admin
PRP_STAGE_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_LONG_ADMIN_PASSWORD

# Remain OFF until real staging TLS, OAuth issuer and identity linking can be tested.
PRP_STAGE_MCP_ENABLED=false
PRP_STAGE_OAUTH_ENABLED=false
