# Keep the monorepo rooted at /repo because Web build contracts read
# both /repo/app/scripts and /repo/.github/workflows.
FROM node:22-alpine AS build
WORKDIR /repo/app/web
COPY app/web/package*.json ./
RUN npm ci
WORKDIR /repo
COPY app ./app
COPY .github ./.github
# Fail the real build if a local staging secret bypasses context exclusions.
RUN test ! -e /repo/app/deploy/mcp-staging/.env
WORKDIR /repo/app/web
ENV VITE_APP_BASE=/prp/
ENV VITE_API_BASE=/api
RUN npm run build && node scripts/verify-deploy-base.mjs /prp/

FROM nginx:1.29-alpine
COPY app/deploy/mcp-staging/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /repo/app/web/dist /usr/share/nginx/html
EXPOSE 8080
