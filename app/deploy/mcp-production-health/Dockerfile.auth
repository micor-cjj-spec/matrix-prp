# CANDIDATE only. Pin base repository digests and the resulting OCI identity before installation.
ARG KEYCLOAK_BASE=quay.io/keycloak/keycloak:26.8.1
FROM ${KEYCLOAK_BASE}
COPY --chown=1000:0 auth-policy/target/prp-production-health-policy.jar /opt/keycloak/providers/prp-production-health-policy.jar
RUN /opt/keycloak/bin/kc.sh build --db=postgres --features=resource-indicators
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm", "--http-enabled=true", "--hostname=https://auth.micor.top", "--proxy-headers=xforwarded", "--proxy-trusted-addresses=127.0.0.1"]
