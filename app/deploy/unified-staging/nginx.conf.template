# Review-only full PRP gateway behind an independently approved HTTPS ingress.
# No OAuth/MCP discovery, handshake, linking or write routes in this baseline.
server {
    listen 8080;
    server_name ${PRP_STAGE_HOST};
    server_tokens off;
    if ($host != ${PRP_STAGE_HOST}) { return 421; }

    location = /prp { return 301 /prp/; }
    location ^~ /prp/api/ { return 404; }
    location = /prp/index.html {
        alias /usr/share/nginx/html/index.html;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /prp/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /prp/index.html;
    }

    location ^~ /.well-known/ { return 404; }
    location ^~ /api/mcp { return 404; }

    location ^~ /api/ {
        client_max_body_size 8m;
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Host ${PRP_STAGE_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 90s;
        add_header Cache-Control "no-store" always;
    }
    location / { return 404; }
}
